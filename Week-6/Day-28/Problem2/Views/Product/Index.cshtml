@model List<WebApplication4.Models.Product>

<h2>Product List</h2>

<table border="1" cellpadding="10" class="table table-striped">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category</th>
        
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Category</td>
          
        </tr>
    }
</table>